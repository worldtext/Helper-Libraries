<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML comments on internal/test-ish members are not errors. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>WorldText.Api</RootNamespace>
    <AssemblyName>WorldText.Api</AssemblyName>
    <PackageId>WorldText.Api</PackageId>
    <Version>1.0.0</Version>
    <Description>Client for the World Text HTTP API (spec version 3.0), bearer authentication.</Description>
  </PropertyGroup>

</Project>